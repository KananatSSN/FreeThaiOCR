# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > token).
TUNNEL_TOKEN=

# Optional donation links shown in the app (baked in at build time; rebuild after changing).
# PromptPay ID: phone number (0812345678), national ID or e-wallet ID.
VITE_PROMPTPAY_ID=
# Ko-fi or Buy Me a Coffee page, e.g. https://ko-fi.com/yourname
VITE_DONATE_URL=
# Public source repository, shown in the About dialog.
VITE_REPO_URL=

# Privacy policy / terms (pages /privacy and /terms). Operator defaults to
# "the FreeThaiOCR maintainer"; contact defaults to the repo's GitHub issues page.
# A contact e-mail is recommended: privacy requests shouldn't have to be public.
VITE_OPERATOR_NAME=
VITE_CONTACT_EMAIL=

# Optional "open to work" card in the support menu (bottom right). Hidden when all are empty.
VITE_HIRE_EMAIL=
VITE_HIRE_PHONE=
# e.g. https://github.com/yourname and https://yourname.dev or a CV link
VITE_HIRE_GITHUB=
VITE_HIRE_WEBSITE=

# Local port for checking the site at http://localhost:8080 (bound to 127.0.0.1 only).
WEB_PORT=8080
